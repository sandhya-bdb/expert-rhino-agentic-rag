# OpenRouter API Key (Get a key for free or paid models at openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# The LLM model to use.
# For free tier usage: openrouter/google/gemini-2.5-flash:free or openrouter/meta-llama/llama-3-8b-instruct:free
# For higher quality: openrouter/openai/gpt-4o-mini
LLM_MODEL=openrouter/openai/gpt-4o-mini
